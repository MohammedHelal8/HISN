[Unit]
Description=HISN FastAPI (localhost only)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=hisn
Group=hisn
WorkingDirectory=/opt/hisn/backend
EnvironmentFile=/etc/hisn/hisn.env
ExecStart=/opt/hisn/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
CapabilityBoundingSet=
LockPersonality=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
