# Copy to backend/.env and chmod 600; DO NOT commit real credentials.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hisn
DB_USER=hisn_app
DB_PASSWORD=CHANGE_ME_STRONG_SECRET
HISN_COOKIE_SECURE=true
HISN_SESSION_HOURS=12
# For Vite development only: HISN_COOKIE_SECURE=false
HISN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HISN_TRUSTED_HOSTS=localhost,127.0.0.1
HISN_E2GUARDIAN_LOG=/var/log/e2guardian/access.log
HISN_SQUID_LOG=/var/log/squid/access.log
HISN_LOG_TIMEZONE=UTC
HISN_LOG_LEVEL=INFO
# For guarded testing only, point this to a HISN-owned file and allow write permissions
HISN_MANAGED_BLOCKLIST=
HISN_ENFORCEMENT_ENABLED=false
HISN_AUTO_ENFORCE=false
HISN_DETECTION_WINDOW_MINUTES=15
HISN_DETECTION_THRESHOLD=3
HISN_SERVICE_CONTROL_ENABLED=false
